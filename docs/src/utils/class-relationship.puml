@startuml cardinality
!include directions.puml

!define ZERO_TO_ONE 0..1
!define ZERO_TO_MANY 0..N
!define ONE_TO_ONE 1..1
!define ONE_TO_TWO 1..2
!define ONE_TO_MANY 1..N
!define EMPTY ""

!define compositionRelation(all, part, cardinality=EMPTY, direction=DOWN) all *-direction-> part: cardinality

!define associationRelation(client, server, cardinality=EMPTY, direction=UP) client -direction[#Purple]--> server: cardinality

!define aggregationRelation(whole, part, cardinality=EMPTY, direction=UP) whole o-direction-> part: cardinality

!define useRelation(user, used, cardinality=EMPTY, direction=DOWN) user .direction[#Orange].> used: cardinality

!define inheritanceRelation(child, parent, cardinality=EMPTY, direction=DOWN) child <|-[#Green]direction- parent: cardinality

@enduml